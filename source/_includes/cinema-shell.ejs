<%
  // ============================================================
  // Cinema shell — fixed background video + transparent content.
  //   The video plays continuously behind every page; scroll does
  //   not displace it. Content sits above with a slow gradient scrim.
  // Inject via theme_inject.bodyBegin in scripts/cinema-inject.js
  // ============================================================
  var menu = (theme && theme.navbar && theme.navbar.menu) || [
    { key: 'home',  link: '/',        name: '博客' },
    { key: 'about', link: '/about/',   name: '介绍' }
  ]
  var brand = (config && config.title) || 'qianhong'
  var video = '/video/hero.mp4'
%>

<!-- ALWAYS-on background. fixed + ken-burns. -->
<video class="bg-video" autoplay loop muted playsinline preload="auto" poster="/img/hero-poster.jpg">
  <source src="<%= video %>" type="video/mp4">
</video>

<!-- Cinematic scrim: dim on top + bottom, transparent in the middle band -->
<div class="bg-scrim"></div>

<!-- Thin fixed letterbox bars (keeps the cinematic frame on every page) -->
<div class="letterbox letterbox-top"></div>
<div class="letterbox letterbox-bottom"></div>

<!-- Transparent left sidebar -->
<aside class="cinema-sidebar" aria-label="<%= __('menu') || 'menu' %>">
  <a class="cinema-brand" href="<%= url_for('/') %>" aria-label="home">
    <span class="cinema-brand-q">q</span>
  </a>

  <nav class="cinema-nav">
    <% for (const each of menu) { %>
      <% if (!each.link) continue %>
      <% var text = each.name || (each.key ? __(each.key + '.menu') : '') || (each.key ? __(each.key + '.title') : '') || each.key %>
      <a class="cinema-nav-item" href="<%= url_for(each.link) %>" data-key="<%= each.key %>">
        <span class="cinema-nav-zh"><%- text %></span>
      </a>
    <% } %>
  </nav>

  <div class="cinema-mode-toggle" id="cinema-mode-toggle" role="button" tabindex="0" aria-label="toggle theme">
    <i class="cinema-mode-icon"></i>
  </div>
</aside>
