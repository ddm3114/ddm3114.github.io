<%
  var menu = theme.navbar.menu || []
  var video = '/video/hero.mp4?v=2'
  var quotes = site.data.quotes || []
%>

<video class="bg-video" autoplay loop muted playsinline preload="auto" poster="/img/hero-poster.jpg"
       style="position:fixed !important; top:0 !important; left:0 !important; width:100vw !important; height:100vh !important; min-width:100vw !important; min-height:100vh !important; object-fit:cover !important; z-index:0 !important;">
  <source src="<%= video %>" type="video/mp4">
</video>

<div class="bg-scrim"
     style="position:fixed !important; inset:0 !important; z-index:1 !important; pointer-events:none !important;"></div>

<div class="letterbox letterbox-top"
     style="position:fixed !important; top:0 !important; left:0 !important; right:0 !important; height:1px !important; background:rgba(245,243,236,0.18) !important; z-index:2 !important; pointer-events:none !important;"></div>
<div class="letterbox letterbox-bottom"
     style="position:fixed !important; bottom:0 !important; left:0 !important; right:0 !important; height:1px !important; background:rgba(245,243,236,0.14) !important; z-index:2 !important; pointer-events:none !important;"></div>

<aside class="cinema-sidebar" aria-label="<%= __('menu') || 'menu' %>">
  <nav class="cinema-nav">
    <% for (const item of menu) { %>
      <% if (!item.link) continue %>
      <a class="cinema-nav-item" href="<%= url_for(item.link) %>" data-key="<%= item.key %>">
        <span class="cinema-nav-zh"><%- item.name || item.key %></span>
      </a>
    <% } %>
  </nav>
</aside>

<% if (quotes.length) { %>
<script id="cinema-quotes" type="application/json"><%- JSON.stringify(quotes) %></script>
<% } %>
